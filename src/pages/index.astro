---
import BaseLayout from '../layouts/BaseLayout.astro';
import Publication from '../components/Publication.astro';
import { getCollection, render } from 'astro:content';
import { site } from '../data/site';

const publications = (await getCollection('publications')).sort(
  (a, b) => a.data.order - b.data.order,
);

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);

const speeches = (await getCollection('speeches')).sort(
  (a, b) => a.data.order - b.data.order,
);

const renderedPublications = await Promise.all(
  publications.map(async (pub) => ({
    pub,
    ...(await render(pub)),
  })),
);

const renderedProjects = await Promise.all(
  projects.map(async (project) => ({
    project,
    ...(await render(project)),
  })),
);

const slugFromId = (id: string) => id.replace(/\.md$/, '');

const pageUrl = (path: string) =>
  `${import.meta.env.BASE_URL}${path.replace(/^\//, '')}`;

const assetUrl = (path: string) =>
  `${import.meta.env.BASE_URL}${encodeURI(path.replace(/^\//, ''))}`;

const externalLinks = [
  { label: 'Email', href: `mailto:${site.email}`, show: true, external: false },
  { label: 'CV', href: assetUrl(site.cv), show: true, external: true },
  { label: 'Scholar', href: site.links.scholar, show: !!site.links.scholar, external: true },
  { label: 'GitHub', href: site.links.github, show: !!site.links.github, external: true },
  { label: 'ORCID', href: site.links.orcid, show: !!site.links.orcid, external: true },
].filter((l) => l.show);
---

<BaseLayout>
  <aside class="sidebar">
    <div class="sidebar-inner">
      <img
        class="portrait"
        src={assetUrl(site.portrait)}
        alt={`Portrait of ${site.name}`}
        width="220"
        height="220"
      />
      <h1>{site.name}</h1>
      <p class="tagline">{site.tagline}</p>
      <p class="meta-line">{site.affiliation}</p>
      <p class="meta-line">{site.degree}</p>
      <p class="meta-line applying">{site.applying}</p>

      <div class="gpa-card">
        <span class="gpa-value">{site.majorGpa}<small>/100</small></span>
        <span class="gpa-label">{site.majorGpaLabel}</span>
      </div>

      <div class="btn-row">
        <a class="btn btn-primary" href={assetUrl(site.cv)} target="_blank" rel="noopener noreferrer">CV</a>
        <a class="btn" href={assetUrl(site.transcript)} download>Transcript</a>
      </div>

      <nav class="link-row" aria-label="Contact links">
        {externalLinks.map((link) => (
          <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>{link.label}</a>
        ))}
      </nav>

      <div class="sidebar-block">
        <h2>Interests</h2>
        <div class="interests">
          {site.interests.map((interest) => (
            <span class="interest-tag">{interest}</span>
          ))}
        </div>
      </div>

      <div class="sidebar-block contact-block">
        <h2>Contact</h2>
        <p>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
        {site.emailAlt && (
          <p>
            <a href={`mailto:${site.emailAlt}`}>{site.emailAlt}</a>
          </p>
        )}
      </div>
    </div>
  </aside>

  <main class="content">
    <section id="news">
      <h2>News</h2>
      <ul class="news-list">
        {site.news.map((item) => (
          <li>
            <span class="news-date">{item.date}</span>
            <span>{item.text}</span>
          </li>
        ))}
      </ul>
    </section>

    <section id="publications">
      <h2>Publications</h2>
      <div class="pub-list">
        {renderedPublications.map(({ pub, Content }) => (
          <Publication pub={pub}>
            <Content />
          </Publication>
        ))}
      </div>
    </section>

    <section id="projects">
      <h2>Projects</h2>
      <div class="project-list">
        {renderedProjects.map(({ project, Content }) => (
          <article class="project-card">
            {project.data.cover && (
              <a class="project-cover-link" href={pageUrl(`projects/${slugFromId(project.id)}/`)}>
                <img
                  class="project-cover"
                  src={assetUrl(project.data.cover)}
                  alt={`${project.data.title} cover`}
                  loading="lazy"
                />
              </a>
            )}
            <h3 class="project-title">
              <a href={pageUrl(`projects/${slugFromId(project.id)}/`)}>{project.data.title}</a>
            </h3>
            {project.data.adoption && (
              <p class="project-highlight">{project.data.adoption}</p>
            )}
            {project.data.role && <p class="project-meta">{project.data.role}</p>}
            {project.data.award && <p class="project-award">{project.data.award}</p>}
            <details class="project-details">
              <summary>About this project</summary>
              <div class="project-body">
                <Content />
              </div>
            </details>
            <div class="card-links">
              <a href={pageUrl(`projects/${slugFromId(project.id)}/`)}>Full page</a>
              <a href={project.data.url} target="_blank" rel="noopener noreferrer">GitHub</a>
              {project.data.playUrl && (
                <a href={assetUrl(project.data.playUrl)} download>Download for Windows</a>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="speeches">
      <h2>Speeches</h2>
      <div class="speech-list">
        {speeches.map((speech) => (
          <article class="speech-card">
            <h3 class="speech-title">
              <a href={pageUrl(`speeches/${slugFromId(speech.id)}/`)}>{speech.data.title}</a>
            </h3>
            <p class="speech-date">{speech.data.date}</p>
            <video class="speech-video" controls preload="metadata">
              <source src={assetUrl(speech.data.video)} type="video/mp4" />
            </video>
            <div class="card-links">
              <a href={pageUrl(`speeches/${slugFromId(speech.id)}/`)}>Open fullscreen</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <footer>
      <p>Last updated {new Date().toISOString().slice(0, 10)}.</p>
    </footer>
  </main>
</BaseLayout>
